{
    "version": "1.0.100",
    "description": "Launcher for Project Ascension, a classless WoW private server",
    "homepage": "https://ascension.gg",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://cdn-launcher.ascension-patch.com/update/ascension-setup-1.0.100.exe",
            "hash": "b0d05766460cd8bc2d45e3f3e0315bd40f870eb9b5a93e90ee257a0582250840"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\$fname\" -Removal",
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Write-Output 'Patching AscensionClientServices.exe manifest to asInvoker...'",
        "$path = \"$dir\\resources\\AscensionClientServices.exe\"",
        "if (Test-Path $path) {",
        "    $bytes = [System.IO.File]::ReadAllBytes($path)",
        "    $old = [System.Text.Encoding]::ASCII.GetBytes('level=\"requireAdministrator\" uiAccess=\"false\"')",
        "    $new = [System.Text.Encoding]::ASCII.GetBytes('level=\"asInvoker\"             uiAccess=\"false\"')",
        "    for ($i = 0; $i -le $bytes.Length - $old.Length; $i++) {",
        "        $m = $true",
        "        for ($j = 0; $j -lt $old.Length; $j++) { if ($bytes[$i + $j] -ne $old[$j]) { $m = $false; break } }",
        "        if ($m) {",
        "            for ($j = 0; $j -lt $new.Length; $j++) { $bytes[$i + $j] = $new[$j] }",
        "            break",
        "        }",
        "    }",
        "    [System.IO.File]::WriteAllBytes($path, $bytes)",
        "    Write-Output 'Patched successfully.'",
        "} else { Write-Output 'Warning: AscensionClientServices.exe not found at $path' }"
    ],
    "shortcuts": [
        [
            "Ascension Launcher.exe",
            "Ascension Launcher"
        ]
    ],
    "checkver": {
        "url": "https://api.ascension.gg/api/bootstrap/launcher",
        "regex": "ascension-setup-([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn-launcher.ascension-patch.com/update/ascension-setup-$version.exe"
            }
        }
    }
}
